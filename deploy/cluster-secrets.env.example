# Phase 19 / Task F1 — template for cluster-secrets.env (gitignored).
# Copy to ./cluster-secrets.env (repo root), fill in real values, then run:
#   bash scripts/create-cluster-secret.sh
#
# These keys must match the secretKeyRef references in deploy/chart/templates/.
# The chart never sees these values directly — they're injected via the
# homecal-secrets Secret created by the script above.

# Required ─────────────────────────────────────────────────────────────
# DATABASE_URL embeds POSTGRES_PASSWORD; both must use the same password so
# initdb (which consumes POSTGRES_PASSWORD) and the API (which connects via
# DATABASE_URL) agree.
DATABASE_URL=postgres://homecal:homecal_prod@homecal-db:5432/homecal_prod
POSTGRES_PASSWORD=homecal_prod

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-this-to-a-32-byte-base64-secret

# Optional ─────────────────────────────────────────────────────────────
# Gmail app password (https://myaccount.google.com/apppasswords). Reminder
# scheduler logs `reminder.dispatch.email_skipped` if missing.
EMAIL_PASSWORD=

# Apple Push Notification cert (.p8 file contents). Multi-line is supported
# by `kubectl create secret --from-env-file` for single values, but for
# multi-line values prefer `--from-file=APNS_PRIVATE_KEY=path/to/cert.p8`
# instead. Reminder scheduler logs `reminder.dispatch.push_skipped` if missing.
APNS_PRIVATE_KEY=
