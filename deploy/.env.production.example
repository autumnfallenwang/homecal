# HomeCal Production Environment
# Copy to .env.production and fill in real values

# Auth (CHANGE THIS - generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-this-to-a-random-secret
BETTER_AUTH_URL=http://192.168.1.163:51001
CORS_ORIGINS=http://192.168.1.163:51000,http://localhost:51000

# LLM Gateway — cluster ingress (llmgw migrated to k3s 2026-05).
# Cluster-internal callers (post Phase-19 cutover) use http://llmgw.llmgw — see deploy/chart/values.yaml.
LLM_GATEWAY_URL=http://llmgw.arch.local
LLM_MODEL=claude-haiku-4-5
LLM_FALLBACK_MODEL=gemma3:27b

# Email notifications (Gmail SMTP)
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Logging — pino level (trace/debug/info/warn/error/fatal)
LOG_LEVEL=info
