#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$HOME/agentic/homecal"
COMPOSE_FILE="$PROJECT_DIR/deploy/compose.yaml"
VERSION=$(node -p "require('$PROJECT_DIR/package.json').version")

case "${1:-help}" in
  start)
    docker compose -f "$COMPOSE_FILE" up -d --build
    echo "homecal v$VERSION running"
    echo "  Web: http://192.168.1.163:51000"
    echo "  API: http://localhost:51001"
    echo "   DB: localhost:51432"
    ;;
  stop)
    docker compose -f "$COMPOSE_FILE" down
    echo "homecal stopped"
    ;;
  restart)
    docker compose -f "$COMPOSE_FILE" restart
    echo "homecal restarted"
    ;;
  logs)
    docker compose -f "$COMPOSE_FILE" logs -f "${2:-}"
    ;;
  status)
    docker compose -f "$COMPOSE_FILE" ps
    ;;
  rebuild)
    docker compose -f "$COMPOSE_FILE" up -d --build --force-recreate
    echo "homecal v$VERSION rebuilt and running"
    ;;
  update)
    cd "$PROJECT_DIR"

    echo "==> Pulling latest from main..."
    git pull origin main

    echo "==> Building and starting containers..."
    docker compose -f "$COMPOSE_FILE" up -d --build --force-recreate

    echo "==> Waiting for database..."
    for i in $(seq 1 30); do
      if docker exec homecal-db-prod pg_isready -U homecal -d homecal_prod > /dev/null 2>&1; then
        break
      fi
      sleep 1
    done

    echo "==> Running database migrations..."
    sleep 2
    docker exec homecal-api pnpm --filter @homecal/api exec drizzle-kit migrate

    echo ""
    echo "homecal v$VERSION updated and running"
    echo "  Web: http://192.168.1.163:51000"
    echo "  API: http://localhost:51001"
    ;;
  version|-v|--version)
    echo "homecal v$VERSION"
    ;;
  *)
    echo "homecal v$VERSION"
    echo "Usage: homecal {start|stop|restart|logs|status|rebuild|update|version}"
    ;;
esac
