# Runtime override for the SSR/rewrite proxy (preferred when set). In k3s
# the chart sets this to http://homecal-api (cluster Service DNS).
# For local dev, omit and let NEXT_PUBLIC_API_URL below be the source.
# API_URL=http://homecal-api

# Build-time fallback for the rewrite proxy. Also baked into the client bundle
# for any future browser-side absolute fetches (none today — all use relative
# paths via the rewrite). Safe to commit as it's a public URL.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Better Auth client baseURL — browser hits /api/auth/* directly here,
# bypassing the rewrite proxy. Baked into the client bundle.
NEXT_PUBLIC_AUTH_URL=http://localhost:3000
