{
  "name": "@homecal/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:fast": "vitest run --exclude 'tests/**/*.integration.test.ts'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/"
  },
  "dependencies": {
    "@homecal/shared": "workspace:*",
    "@hono/node-server": "^1.19.9",
    "better-auth": "^1.4.19",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.9",
    "node-ical": "^0.26.0",
    "nodemailer": "^8.0.4",
    "postgres": "^3.4.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/node": "^25.2.2",
    "@types/nodemailer": "^7.0.11",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
